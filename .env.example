# Copia este archivo a .env y rellena los valores. .env está en .gitignore: NO se sube.
# En Render estas mismas variables se configuran en Environment, no con un archivo.

# --- Subida de contenido (posts y reels) ---
# service_role key de Supabase. Dashboard > Project Settings > API > service_role.
# Da acceso total a la base de datos: nunca la pongas en el frontend ni la subas a git.
SUPABASE_SERVICE_KEY=
# Bucket de Supabase Storage donde se guardan los archivos (por defecto: contenido)
SUPABASE_BUCKET=contenido

# --- Supabase (ya tienen valores por defecto en el código) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Resto de servicios ---
GEMINI_API_KEY=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
ATLAS_API_KEY=
APP_URL=
PORT=10000

# --- Publicar en redes (Zernio) ---
# zernio.com > Settings > API Keys. Formato sk_ + 64 hex. Solo se ve una vez al crearla.
# Sin esta llave la app funciona igual, pero el botón de publicar avisa que no está configurado.
ZERNIO_API_KEY=

# --- Instagram directo (comentario → DM) ---
# Esto NO pasa por Zernio: la respuesta privada a un comentario es una capacidad de Meta que
# Zernio no expone (su respuesta a comentarios es pública). Se saca de una app propia en
# developers.facebook.com, producto "Instagram" con Instagram Login.
#
# Con Standard Access basta para cuentas propias. Para cuentas de clientes hace falta
# Advanced Access, que exige App Review y verificación de negocio.
#
# La URL de retorno a registrar en la app de Meta es:
#   https://portal.inmersiaperformance.cl/api/ig/callback
# Y la del webhook (campo "comments"):
#   https://portal.inmersiaperformance.cl/api/ig/webhook
IG_APP_ID=
IG_APP_SECRET=
# Cadena que tú inventas. Se escribe igual aquí y en el panel de Meta al dar de alta el
# webhook: Meta la devuelve para comprobar que el endpoint es tuyo.
IG_WEBHOOK_VERIFY_TOKEN=

# --- Notificaciones push (Web Push / VAPID) ---
# Se generan una sola vez con: npx web-push generate-vapid-keys
# Sin estas dos, la app funciona pero no salen notificaciones al teléfono.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:inmersiatours@gmail.com

# --- Reuniones con Google Meet ---
# Cuenta que figura como organizadora de TODAS las reuniones. Tiene que haber iniciado
# sesión con Google en la app al menos una vez para que quede su permiso de calendario.
MEET_ORGANIZER=inmersiatours@gmail.com
